# Create a Reddit "script" app at https://www.reddit.com/prefs/apps to get these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wsb-stock-suggestor by u/your_reddit_username

# Subreddit to analyze (no leading r/)
SUBREDDIT=wallstreetbets

# How many posts to pull per refresh, and from which listing (hot/new/top)
POST_LIMIT=150
POST_LISTING=hot

# How many top-level comments to analyze per post (0 to skip comments, faster)
COMMENTS_PER_POST=15

# How long to cache results before re-fetching from Reddit, in seconds
CACHE_TTL_SECONDS=900
