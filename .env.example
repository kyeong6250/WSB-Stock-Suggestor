# Which backend fetches Reddit posts. "arctic_shift" needs zero setup — no
# API key, no login, nothing to fill in below it works out of the box.
# Reddit locked self-serve creation of new API apps behind manual approval in
# 2026, so "praw" (the official API) is only worth using if you already have
# — or can get approved for — a Reddit API app.
DATA_SOURCE=arctic_shift

# How far back (in hours) to look for posts when using arctic_shift, which has
# no "hot"/"rising" concept of its own — this app does its own score/flair-
# weighted ranking on whatever's posted in this window (see README).
ARCTIC_SHIFT_WINDOW_HOURS=24

# arctic_shift only: how many of the highest-scoring posts to fetch comments
# for. Comment-fetching costs one HTTP request per post (no batch endpoint),
# so this bounds refresh time regardless of POST_LIMIT — raise it for richer
# signal at the cost of a slower refresh, lower it for a snappier one.
ARCTIC_SHIFT_MAX_COMMENT_FETCHES=40

# --- Only needed if DATA_SOURCE=praw ---
# Create an "installed app" (NOT "script") at https://www.reddit.com/prefs/apps
# to get this. Installed apps have no secret to copy — just paste the client ID
# shown under the app's name. See README.md > Setup for the full walkthrough.
REDDIT_CLIENT_ID=
REDDIT_USER_AGENT=wsb-stock-suggestor by u/your_reddit_username

# Subreddit to analyze (no leading r/)
SUBREDDIT=wallstreetbets

# How many posts to pull per refresh. With arctic_shift this is a cap on
# posts within ARCTIC_SHIFT_WINDOW_HOURS (set generously high by default so
# it rarely actually truncates — WSB typically has ~150-250 posts/day); with
# praw it's per listing below.
POST_LIMIT=300

# praw only: which listing(s) to pull from, comma-separated to merge them,
# deduplicated (e.g. "hot,rising") — "hot" alone skews toward posts that have
# been popular for a while, so mixing in "rising" keeps the ranking from
# leaning entirely on stale-but-still-hot threads.
# Valid values: hot, new, top, rising
POST_LISTING=hot,rising

# How many top-level comments to analyze per post (0 to skip comments, faster)
COMMENTS_PER_POST=15

# Ceiling on how stale served data is allowed to get before a request blocks
# on a synchronous refetch, in seconds. This is a fallback, not the primary
# freshness mechanism — see BACKGROUND_REFRESH_INTERVAL_SECONDS below, which
# keeps the cache warm well under this in normal operation. Default is a full
# day; lower it if you want requests to force a refetch sooner on their own.
CACHE_TTL_SECONDS=86400

# How often (in seconds) to proactively refresh in the background, independent
# of traffic. This is what actually drives freshness day-to-day, and it's also
# what makes the "Overall Sentiment" trend sparkline accumulate points over
# time instead of just sitting flat between visits.
BACKGROUND_REFRESH_INTERVAL_SECONDS=1800

# How many points the sentiment-history sparkline keeps before dropping the
# oldest. At the default 30-minute refresh interval, 50 points is a bit over
# a day of history.
SENTIMENT_HISTORY_MAX_POINTS=50
